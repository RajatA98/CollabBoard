rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users — any authenticated user can read (needed for search), only self can write
    // Username changes are handled by Cloud Functions with admin SDK
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId
                   && !("username" in request.resource.data
                        && resource != null
                        && "username" in resource.data
                        && request.resource.data.username != resource.data.username);

      // Friends subcollection — read own, writes handled by Cloud Functions
      match /friends/{friendId} {
        allow read: if request.auth.uid == userId;
        allow write: if false;
      }

      // Invitations subcollection — read own, writes handled by Cloud Functions
      match /invitations/{invitationId} {
        allow read: if request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Usernames — read for authenticated users, write via Cloud Function only
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Board metadata
    match /boardMeta/{boardId} {
      allow read: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid in resource.data.members ||
        (resource.data.collaboratorUids != null && request.auth.uid in resource.data.collaboratorUids) ||
        resource.data.visibility == 'open'
      );
      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid
                    && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid in resource.data.members ||
        (resource.data.collaboratorUids != null
         && request.auth.uid in resource.data.collaboratorUids)
      );
      allow delete: if request.auth != null
                    && resource.data.creatorId == request.auth.uid;
    }

    // Board objects (canvas shapes)
    match /boards/{boardId} {
      allow read, write: if request.auth != null;

      match /objects/{objectId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
